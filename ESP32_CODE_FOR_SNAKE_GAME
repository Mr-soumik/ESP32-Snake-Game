#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Preferences.h>

Adafruit_SSD1306 display(128, 64, &Wire, -1);
Preferences prefs;

const uint8_t BTN[4] = {18, 5, 4, 15};
const uint8_t PIN_BUZZ = 2;
enum { B_UP, B_DOWN, B_LEFT, B_RIGHT };

const int COLS = 31, ROWS = 13, CELL = 4, OX = 2, OY = 10;
const int MAXLEN = COLS * ROWS;
const int BONUS_MS = 6000;

uint8_t sx[MAXLEN + 2], sy[MAXLEN + 2];
int len, dx, dy, fx, fy, bx, by, score, eaten, level = 0;
bool bonusOn, newHigh;
uint32_t bonusEnd, lastMove, buzOff, overStart;
uint16_t hiScore[3];
int8_t qdx[2], qdy[2];
uint8_t qn;

bool btnState[4], btnLast[4];
uint32_t btnTime[4];
uint8_t pressed;

enum State { ST_MENU, ST_PLAY, ST_OVER };
State state = ST_MENU;

const char* levelName[3] = {"EASY", "NORMAL", "HARD"};
const int baseMs[3] = {250, 195, 145};
const int minMs[3] = {160, 120, 85};

void scanButtons() {
  pressed = 0;
  for (int i = 0; i < 4; i++) {
    bool r = digitalRead(BTN[i]) == LOW;
    if (r != btnLast[i]) {
      btnLast[i] = r;
      btnTime[i] = millis();
    }
    if (millis() - btnTime[i] > 18 && r != btnState[i]) {
      btnState[i] = r;
      if (r) pressed |= (1 << i);
    }
  }
}

void beep(int ms) {
  digitalWrite(PIN_BUZZ, HIGH);
  buzOff = millis() + ms;
}

void centerText(const char* s, int y, int size) {
  int w = strlen(s) * 6 * size;
  display.setTextSize(size);
  display.setCursor((128 - w) / 2, y);
  display.print(s);
}

bool cellFree(int x, int y) {
  for (int i = 0; i < len; i++) if (sx[i] == x && sy[i] == y) return false;
  if (x == fx && y == fy) return false;
  if (bonusOn && x == bx && y == by) return false;
  return true;
}

void spawnCell(int &ox, int &oy) {
  int x, y;
  do {
    x = random(COLS);
    y = random(ROWS);
  } while (!cellFree(x, y));
  ox = x;
  oy = y;
}

void drawHud() {
  char b[16];
  display.setTextSize(1);
  display.setTextColor(WHITE);
  snprintf(b, sizeof b, "SC %d", score);
  display.setCursor(1, 0);
  display.print(b);
  int h = hiScore[level] > score ? hiScore[level] : score;
  snprintf(b, sizeof b, "HI %d", h);
  display.setCursor(127 - strlen(b) * 6, 0);
  display.print(b);
  if (bonusOn) {
    int32_t left = (int32_t)(bonusEnd - millis());
    if (left < 0) left = 0;
    int w = left * 30 / BONUS_MS;
    display.drawRect(48, 1, 32, 6, WHITE);
    display.fillRect(49, 2, w, 4, WHITE);
  } else {
    const char* n = levelName[level];
    display.setCursor((128 - strlen(n) * 6) / 2, 0);
    display.print(n);
  }
}

void drawApple() {
  int x = OX + fx * CELL, y = OY + fy * CELL;
  display.fillRect(x, y + 1, 4, 3, WHITE);
  display.drawPixel(x, y + 3, BLACK);
  display.drawPixel(x + 3, y + 3, BLACK);
  display.drawPixel(x + 2, y, WHITE);
  if ((millis() / 350) % 2) display.drawPixel(x + 1, y + 2, BLACK);
}

void drawBonus() {
  if ((millis() / 160) % 2 == 0 && (int32_t)(bonusEnd - millis()) < 1800) return;
  int x = OX + bx * CELL, y = OY + by * CELL;
  display.fillRect(x + 1, y, 2, 4, WHITE);
  display.fillRect(x, y + 1, 4, 2, WHITE);
  if ((millis() / 250) % 2) display.drawPixel(x + 1, y + 1, BLACK);
}

void drawHead() {
  int x = OX + sx[0] * CELL, y = OY + sy[0] * CELL;
  bool t = (millis() / 260) % 2;
  display.fillRoundRect(x - 1, y - 1, 6, 6, 2, WHITE);
  if (dx == 1) {
    display.drawPixel(x + 3, y, BLACK);
    display.drawPixel(x + 3, y + 3, BLACK);
    if (t) {
      display.drawPixel(x + 5, y + 1, WHITE);
      display.drawPixel(x + 6, y + 1, WHITE);
      display.drawPixel(x + 7, y, WHITE);
      display.drawPixel(x + 7, y + 2, WHITE);
    }
  } else if (dx == -1) {
    display.drawPixel(x, y, BLACK);
    display.drawPixel(x, y + 3, BLACK);
    if (t) {
      display.drawPixel(x - 2, y + 1, WHITE);
      display.drawPixel(x - 3, y + 1, WHITE);
      display.drawPixel(x - 4, y, WHITE);
      display.drawPixel(x - 4, y + 2, WHITE);
    }
  } else if (dy == -1) {
    display.drawPixel(x, y, BLACK);
    display.drawPixel(x + 3, y, BLACK);
    if (t) {
      display.drawPixel(x + 1, y - 2, WHITE);
      display.drawPixel(x + 1, y - 3, WHITE);
      display.drawPixel(x, y - 4, WHITE);
      display.drawPixel(x + 2, y - 4, WHITE);
    }
  } else {
    display.drawPixel(x, y + 3, BLACK);
    display.drawPixel(x + 3, y + 3, BLACK);
    if (t) {
      display.drawPixel(x + 1, y + 5, WHITE);
      display.drawPixel(x + 1, y + 6, WHITE);
      display.drawPixel(x, y + 7, WHITE);
      display.drawPixel(x + 2, y + 7, WHITE);
    }
  }
}

void drawSnake() {
  for (int i = len - 1; i >= 1; i--) {
    int x = OX + sx[i] * CELL, y = OY + sy[i] * CELL;
    if (i == len - 1) {
      int px = (int)sx[i - 1] - sx[i], py = (int)sy[i - 1] - sy[i];
      display.fillRect(x + 1, y + 1, 2, 2, WHITE);
      display.fillRect(x + 1 + px, y + 1 + py, 2, 2, WHITE);
    } else {
      display.fillRoundRect(x, y, 4, 4, 1, WHITE);
      if ((len - i) % 2 == 0) display.drawPixel(x + 1, y + 1, BLACK);
    }
  }
  drawHead();
}

void drawScene(bool showSnake) {
  display.clearDisplay();
  drawHud();
  display.drawRect(0, 8, 128, 56, WHITE);
  drawApple();
  if (bonusOn) drawBonus();
  if (showSnake) drawSnake();
  display.display();
}

void queueDir(int ndx, int ndy) {
  int rx = qn ? qdx[qn - 1] : dx;
  int ry = qn ? qdy[qn - 1] : dy;
  if (ndx == rx && ndy == ry) return;
  if (ndx == -rx && ndy == -ry) return;
  if (qn < 2) {
    qdx[qn] = ndx;
    qdy[qn] = ndy;
    qn++;
  }
}

void startGame() {
  len = 3;
  dx = 1;
  dy = 0;
  qn = 0;
  score = 0;
  eaten = 0;
  bonusOn = false;
  newHigh = false;
  int cx = COLS / 2, cy = ROWS / 2;
  for (int i = 0; i < len; i++) {
    sx[i] = cx - i;
    sy[i] = cy;
  }
  fx = -1;
  fy = -1;
  spawnCell(fx, fy);
  for (int n = 3; n >= 1; n--) {
    drawScene(true);
    display.fillRect(50, 20, 28, 30, BLACK);
    display.drawRect(50, 20, 28, 30, WHITE);
    display.setTextSize(3);
    display.setCursor(55, 23);
    display.print(n);
    display.display();
    beep(50);
    delay(650);
  }
  beep(120);
  state = ST_PLAY;
  lastMove = millis();
}

void gameOver() {
  beep(350);
  for (int i = 0; i < 4; i++) {
    drawScene(i % 2);
    delay(180);
  }
  newHigh = score > hiScore[level];
  if (newHigh) {
    hiScore[level] = score;
    char k[8];
    snprintf(k, sizeof k, "hi%d", level);
    prefs.putUShort(k, score);
  }
  state = ST_OVER;
  overStart = millis();
}

void stepSnake() {
  if (qn) {
    dx = qdx[0];
    dy = qdy[0];
    qdx[0] = qdx[1];
    qdy[0] = qdy[1];
    qn--;
  }
  int nx = sx[0] + dx, ny = sy[0] + dy;
  if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) {
    if (level == 0) {
      nx = (nx + COLS) % COLS;
      ny = (ny + ROWS) % ROWS;
    } else {
      gameOver();
      return;
    }
  }
  bool eat = (nx == fx && ny == fy);
  bool bon = bonusOn && nx == bx && ny == by;
  int chk = (eat || bon) ? len : len - 1;
  for (int i = 0; i < chk; i++) {
    if (sx[i] == nx && sy[i] == ny) {
      gameOver();
      return;
    }
  }
  memmove(sx + 1, sx, len);
  memmove(sy + 1, sy, len);
  sx[0] = nx;
  sy[0] = ny;
  if (eat || bon) {
    if (len < MAXLEN) len++;
  }
  if (eat) {
    score += 10;
    eaten++;
    beep(40);
    spawnCell(fx, fy);
    if (eaten % 5 == 0 && !bonusOn) {
      spawnCell(bx, by);
      bonusOn = true;
      bonusEnd = millis() + BONUS_MS;
    }
  }
  if (bon) {
    score += 50;
    bonusOn = false;
    beep(110);
  }
}

void playLoop() {
  if (pressed & (1 << B_UP)) queueDir(0, -1);
  if (pressed & (1 << B_DOWN)) queueDir(0, 1);
  if (pressed & (1 << B_LEFT)) queueDir(-1, 0);
  if (pressed & (1 << B_RIGHT)) queueDir(1, 0);
  if (bonusOn && (int32_t)(bonusEnd - millis()) <= 0) bonusOn = false;
  int interval = baseMs[level] - eaten * 2;
  if (interval < minMs[level]) interval = minMs[level];
  if (millis() - lastMove >= (uint32_t)interval) {
    lastMove = millis();
    stepSnake();
    if (state != ST_PLAY) return;
  }
  drawScene(true);
}

void menuLoop() {
  if (pressed & (1 << B_LEFT)) {
    level = (level + 2) % 3;
    beep(15);
  }
  if (pressed & (1 << B_RIGHT)) {
    level = (level + 1) % 3;
    beep(15);
  }
  if (pressed & ((1 << B_UP) | (1 << B_DOWN))) {
    beep(60);
    startGame();
    return;
  }
  char b[20];
  display.clearDisplay();
  display.setTextColor(WHITE);
  centerText("SNAKE", 2, 2);
  display.drawFastHLine(20, 20, 88, WHITE);
  display.setTextSize(1);
  display.setCursor(12, 28);
  display.print("<");
  display.setCursor(110, 28);
  display.print(">");
  centerText(levelName[level], 28, 1);
  snprintf(b, sizeof b, "BEST %d", hiScore[level]);
  centerText(b, 40, 1);
  if ((millis() / 500) % 2) centerText("PRESS UP / DOWN", 54, 1);
  display.display();
}

void overLoop() {
  char b[20];
  display.clearDisplay();
  display.setTextColor(WHITE);
  centerText("GAME OVER", 4, 2);
  snprintf(b, sizeof b, "SCORE %d", score);
  centerText(b, 28, 1);
  snprintf(b, sizeof b, "BEST %d", hiScore[level]);
  centerText(b, 40, 1);
  if (newHigh) {
    if ((millis() / 300) % 2) centerText("NEW HIGH SCORE!", 54, 1);
  } else {
    if ((millis() / 500) % 2) centerText("PRESS ANY KEY", 54, 1);
  }
  display.display();
  if (millis() - overStart > 1200 && pressed) {
    beep(30);
    state = ST_MENU;
  }
}

void splash() {
  for (int f = 0; f < 95; f++) {
    scanButtons();
    if (pressed) break;
    display.clearDisplay();
    display.setTextColor(WHITE);
    centerText("SNAKE", 4, 2);
    centerText("TECHTADKA360", 24, 1);
    int hx = f * 2;
    for (int k = 22; k >= 0; k--) {
      int px = hx - k * 4;
      if (px < -4 || px > 131) continue;
      int py = 50 + (int)(sin(px / 10.0) * 9);
      int r = (k == 0) ? 3 : (k > 16 ? 1 : 2);
      display.fillCircle(px, py, r, WHITE);
      if (k == 0) display.drawPixel(px + 1, py - 1, BLACK);
    }
    display.display();
    delay(25);
  }
}

void setup() {
  for (int i = 0; i < 4; i++) pinMode(BTN[i], INPUT_PULLUP);
  pinMode(PIN_BUZZ, OUTPUT);
  digitalWrite(PIN_BUZZ, LOW);
  Wire.begin(21, 22);
  Wire.setClock(400000);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (true) delay(1000);
  }
  randomSeed(esp_random());
  prefs.begin("snake", false);
  for (int i = 0; i < 3; i++) {
    char k[8];
    snprintf(k, sizeof k, "hi%d", i);
    hiScore[i] = prefs.getUShort(k, 0);
  }
  splash();
  state = ST_MENU;
}

void loop() {
  scanButtons();
  if (buzOff && (int32_t)(millis() - buzOff) >= 0) {
    digitalWrite(PIN_BUZZ, LOW);
    buzOff = 0;
  }
  if (state == ST_MENU) menuLoop();
  else if (state == ST_PLAY) playLoop();
  else overLoop();
}
